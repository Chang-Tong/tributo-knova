diff --git a/tests/test_xgboost_worker_shards.py b/tests/test_xgboost_worker_shards.py
new file mode 100644
index 0000000..27f56e7
--- /dev/null
+++ b/tests/test_xgboost_worker_shards.py
@@ -0,0 +1,159 @@
+"""Real Ray regressions for sparse blocks and lossless training shards.
+
+Run directly against an existing local cluster with RAY_ADDRESS=auto, or let
+pytest start an isolated local Ray runtime. Only the connection is shut down
+when using an existing cluster.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import unittest
+from typing import Any
+
+import pyarrow as pa
+import ray
+from ray.train import RunConfig, ScalingConfig
+from ray.train.xgboost import XGBoostTrainer
+from tributo_algorithms_boosting import training as runtime
+from tributo_algorithms_boosting.data_config import CompleteCoverageDataConfig
+
+
+def _sparse_dataset(rows: int, blocks: int = 200) -> Any:
+    table = pa.table(
+        {
+            "id": list(range(rows)),
+            "feature": [float(index % 7) for index in range(rows)],
+            "label": [index % 2 for index in range(rows)],
+        }
+    )
+    return ray.data.from_arrow([table, *[table.slice(0, 0)] * (blocks - 1)])
+
+
+def _collect_shard(shard: Any) -> list[int]:
+    return [
+        int(value)
+        for batch in shard.iter_batches(batch_format="numpy", batch_size=64)
+        for value in batch["id"]
+    ]
+
+
+def _worker_ids(dataset: Any, workers: int) -> list[list[int]]:
+    shards = CompleteCoverageDataConfig(datasets_to_split=["train"]).configure(
+        {"train": dataset}, workers, None, None
+    )
+    collect = ray.remote(num_cpus=0)(_collect_shard)
+    return ray.get(
+        [collect.remote(shard["train"]) for shard in shards], timeout=120
+    )
+
+
+class TestWorkerShardCoverage(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        if os.environ.get("RAY_ADDRESS"):
+            ray.init(address=os.environ["RAY_ADDRESS"])
+        else:
+            ray.init(num_cpus=4, include_dashboard=False, object_store_memory=134217728)
+        ray.data.DataContext.get_current().enable_progress_bars = False
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        ray.shutdown()
+
+    def _assert_shards(
+        self, dataset: Any, rows: int, workers: int, name: str = "train"
+    ) -> list[list[int]]:
+        prepared = runtime._ensure_worker_blocks(
+            dataset, worker_count=workers, row_count=rows, name=name
+        ).materialize()
+        shards = _worker_ids(prepared, workers)
+        self.assertTrue(all(shards), [len(shard) for shard in shards])
+        self.assertEqual(sum(map(len, shards)), rows)
+        self.assertEqual(len({value for shard in shards for value in shard}), rows)
+        self.assertLessEqual(max(map(len, shards)) - min(map(len, shards)), 1)
+        return shards
+
+    def test_sparse_three_way_split_preserves_all_rows(self) -> None:
+        train, validation, test, rows = runtime._split_dataset(
+            _sparse_dataset(834),
+            {
+                "train_ratio": 0.65,
+                "validation_ratio": 0.15,
+                "test_ratio": 0.20,
+                "split_strategy": "RANDOM",
+                "seed": 42,
+            },
+        )
+        all_ids: list[int] = []
+        counts = {}
+        for name, dataset in (("train", train), ("validation", validation), ("test", test)):
+            shards = self._assert_shards(dataset, rows[name], 2, name)
+            counts[name] = list(map(len, shards))
+            all_ids.extend(value for shard in shards for value in shard)
+        self.assertEqual(sorted(all_ids), list(range(834)))
+        print(json.dumps({"case": "sparse_three_way", "rows": rows, "shards": counts}))
+
+    def test_odd_rows_and_existing_worker_block_count(self) -> None:
+        shards = self._assert_shards(_sparse_dataset(835, blocks=2), 835, 2)
+        self.assertEqual(sorted(value for shard in shards for value in shard), list(range(835)))
+        print(json.dumps({"case": "odd_rows", "shards": list(map(len, shards))}))
+
+    def test_minimum_rows_and_too_few_rows(self) -> None:
+        shards = self._assert_shards(_sparse_dataset(4), 4, 4)
+        self.assertEqual(list(map(len, shards)), [1, 1, 1, 1])
+        for rows in (0, 1, 3):
+            with self.assertRaisesRegex(ValueError, "fewer rows than XGBoost workers"):
+                runtime._ensure_worker_blocks(
+                    _sparse_dataset(rows), worker_count=4, row_count=rows, name="validation"
+                )
+        print(json.dumps({"case": "minimum_rows", "shards": list(map(len, shards))}))
+
+    def test_xgboost_two_workers_receive_train_and_validation(self) -> None:
+        datasets = {
+            name: runtime._ensure_worker_blocks(
+                _sparse_dataset(rows), worker_count=2, row_count=rows, name=name
+            )
+            for name, rows in (("train", 543), ("validation", 125))
+        }
+        evidence = ray.remote(runtime._EvidenceCollector).options(num_cpus=0).remote()
+        try:
+            with tempfile.TemporaryDirectory(
+                prefix="tributo-shard-regression-",
+                dir=os.environ.get("TRIBUTO_TEST_SHARED_STORAGE"),
+            ) as root:
+                trainer = XGBoostTrainer(
+                    train_loop_per_worker=runtime._xgboost_train_loop,
+                    train_loop_config={
+                        "feature_names": ["feature"],
+                        "label_name": "label",
+                        "params": {"objective": "binary:logistic", "eval_metric": "logloss"},
+                        "num_rounds": 3,
+                        "batch_rows": 64,
+                        "evidence_actor": evidence,
+                    },
+                    scaling_config=ScalingConfig(num_workers=2, resources_per_worker={"CPU": 1}),
+                    datasets=datasets,
+                    dataset_config=CompleteCoverageDataConfig(datasets_to_split="all"),
+                    run_config=RunConfig(storage_path=root, name="empty-block-regression"),
+                )
+                result = trainer.fit()
+                self.assertIsNotNone(result.checkpoint)
+            records = ray.get(evidence.snapshot.remote())
+            self.assertEqual(len(records), 2)
+            self.assertEqual(sum(item["input_rows"]["train"] for item in records), 543)
+            self.assertEqual(sum(item["input_rows"]["validation"] for item in records), 125)
+            for record in records:
+                self.assertGreater(record["input_rows"]["train"], 0)
+                self.assertGreater(record["input_rows"]["validation"], 0)
+                self.assertEqual(record["collective_steps"], 3)
+            self.assertEqual(len({item["model_state_digest"] for item in records}), 1)
+            print(json.dumps({"case": "xgboost_two_workers", "input_rows": [item["input_rows"] for item in records]}))
+        finally:
+            ray.kill(evidence)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
