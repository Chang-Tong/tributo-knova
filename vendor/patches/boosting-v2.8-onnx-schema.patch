                     output.name = field.name
+        # Keep the fitted matrix contract inside the integrity-checked model.
+        # Request feature arrays describe data acquisition, not model order.
+        # Preserve converter metadata while recording only trusted model facts.
+        from onnx import helper
+
+        if (
+            len(feature_names) != int(booster.num_features())
+            or len(set(feature_names)) != len(feature_names)
+            or any(not name for name in feature_names)
+        ):
+            raise ValueError("XGBoost feature schema does not match the model")
+        objective = str(configuration["objective"]["name"])
+        task_type = (
+            "BINARY_CLASSIFICATION" if objective.startswith("binary:")
+            else "MULTICLASS_CLASSIFICATION" if objective.startswith("multi:")
+            else "REGRESSION"
+        )
+        metadata = {item.key: item.value for item in converted.metadata_props}
+        metadata.update(
+            feature_names=json.dumps(feature_names, ensure_ascii=False),
+            task_type=task_type,
+            objective=objective,
+            framework="xgboost",
+            num_features=str(booster.num_features()),
+        )
+        if objective.startswith(("binary:", "multi:")):
+            metadata["num_classes"] = str(
+                max(2, int(configuration["learner_model_param"]["num_class"]))
+            )
+        helper.set_model_props(converted, metadata)
         converted.graph.name = "tributo-official-xgboost"
