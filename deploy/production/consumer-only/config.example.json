{
  "broker_id": "tributo-knova",
  "api_version": 1,
  "transport": {
    "mode": "sentinel",
    "sentinel_nodes": [
      "redis-sentinel-a:26379",
      "redis-sentinel-b:26379",
      "redis-sentinel-c:26379"
    ],
    "driver_sentinel_nodes": [
      "redis-sentinel-a:26379",
      "redis-sentinel-b:26379",
      "redis-sentinel-c:26379"
    ],
    "sentinel_master": "mymaster",
    "database": 3,
    "password_ref": "env:KNOVA_REDIS_PASSWORD",
    "block_ms": 1000,
    "claim_idle_ms": 60000,
    "max_driver_input_bytes": 262144,
    "sentinel_password_ref": "env:KNOVA_REDIS_SENTINEL_PASSWORD"
  },
  "channels": {
    "training": {
      "task_stream_key": "knova:aimodel:training:distributed:tasks",
      "event_stream_prefix": "knova:aimodel:training:distributed:events",
      "cancel_key_prefix": "knova:aimodel:training:distributed:cancel",
      "consumer_group": "knova-trainers",
      "consumer_name": "tributo-knova-training",
      "group_start_id": "0-0",
      "outer_identity_field": "job_id"
    },
    "batch_inference": {
      "task_stream_key": "knova:aimodel:inference:distributed:tasks",
      "event_stream_prefix": "knova:aimodel:inference:distributed:events",
      "cancel_key_prefix": "knova:aimodel:inference:distributed:cancel",
      "consumer_group": "knova-backend-inference",
      "consumer_name": "tributo-knova-inference",
      "group_start_id": "0-0",
      "outer_identity_field": "execution_id"
    }
  },
  "operations": {
    "training": {
      "execution_profiles": [
        "distributed"
      ]
    },
    "batch_inference": {
      "execution_profiles": [
        "distributed"
      ]
    }
  },
  "execution": {
    "ray_dashboard_url": "http://YOUR_RAY_HEAD_SERVICE:8265",
    "project_root": "/opt/tributo-runtime/core",
    "extra_py_modules": [
      "/opt/tributo-runtime/extensions/tributo_knova",
      "/opt/tributo-runtime/extensions/tributo_broker_redis",
      "/opt/tributo-runtime/extensions/tributo_algorithms_boosting"
    ],
    "env_vars": {
      "PYTHONUNBUFFERED": "1"
    },
    "entrypoint_num_cpus": 0
  }
}
