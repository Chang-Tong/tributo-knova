[Unit]
Description=Tributo KnoVa Redis consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tributo-knova
Group=tributo-knova
EnvironmentFile=-/etc/tributo-knova/environment
ExecStartPre=/opt/tributo-knova/bin/tributo-knova health --config /etc/tributo-knova/config.json
ExecStart=/opt/tributo-knova/bin/tributo-knova consume --config /etc/tributo-knova/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tributo-knova

[Install]
WantedBy=multi-user.target
